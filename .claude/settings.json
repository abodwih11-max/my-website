{
  "extraKnownMarketplaces": {
    "hyperframes": {
      "source": {
        "source": "github",
        "repo": "heygen-com/hyperframes"
      }
    },
    "lemolab": {
      "source": {
        "source": "github",
        "repo": "lemomo-ai/lemo-opuscar"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "enabledPlugins": {
    "hyperframes@hyperframes": true,
    "lemo-opuscar@lemolab": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/install-plugins.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
